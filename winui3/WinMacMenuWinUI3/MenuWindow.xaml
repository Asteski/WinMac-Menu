<Window
    x:Class="WinMacMenuWinUI3.MenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinMacMenuWinUI3"
    xmlns:models="using:WinMacMenuWinUI3.Models">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="MenuPanel"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4,4,4,4"
                MinWidth="220"
                MaxWidth="320"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="600">
                <ItemsRepeater x:Name="MenuItemsRepeater"
                               ItemsSource="{x:Bind MenuItems}"
                               ElementPrepared="MenuItemsRepeater_ElementPrepared">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ConfigItem">
                            <local:MenuItemControl Item="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" Orientation="Vertical" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
