<Window
    x:Class="WinMacMenuWinUI3.MenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinMacMenuWinUI3"
    xmlns:models="using:WinMacMenuWinUI3.Models">

    <!--
        The window itself is transparent (no system chrome).
        The menu card is a solid-white rounded panel with elevation shadow,
        matching the Windows 11 context menu appearance.
    -->
    <Grid Background="Transparent">

        <Border x:Name="MenuCard"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                MinWidth="220"
                MaxWidth="320"
                Padding="4"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="580">
                <ItemsRepeater x:Name="MenuItemsRepeater"
                               ItemsSource="{x:Bind MenuItems}"
                               ElementPrepared="MenuItemsRepeater_ElementPrepared">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:ConfigItem">
                            <local:MenuItemControl Item="{x:Bind}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" Orientation="Vertical"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
