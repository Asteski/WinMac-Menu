<UserControl
    x:Class="WinMacMenuWinUI3.MenuItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinMacMenuWinUI3"
    xmlns:models="using:WinMacMenuWinUI3.Models">

    <UserControl.Resources>
        <!-- Hover highlight style -->
        <Style x:Key="MenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid"
                              Background="{TemplateBinding Background}"
                              CornerRadius="4">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Separator -->
        <Rectangle x:Name="SeparatorLine"
                   Height="1"
                   Margin="12,4,12,4"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                   Visibility="Collapsed" />

        <!-- Category header -->
        <TextBlock x:Name="CategoryLabel"
                   Margin="12,6,12,2"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Category"
                   Visibility="Collapsed"
                   TextTrimming="CharacterEllipsis" />

        <!-- Normal / submenu item -->
        <Button x:Name="ItemButton"
                Style="{StaticResource MenuItemButtonStyle}"
                Click="ItemButton_Click"
                Visibility="Collapsed">
            <Grid Height="34" Padding="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Image x:Name="ItemIcon"
                       Grid.Column="0"
                       Width="16" Height="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

                <!-- Label -->
                <TextBlock x:Name="ItemLabel"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Text="Item" />

                <!-- Submenu arrow -->
                <FontIcon x:Name="SubArrow"
                          Grid.Column="2"
                          Glyph="&#xE76C;"
                          FontSize="10"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Visibility="Collapsed" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
