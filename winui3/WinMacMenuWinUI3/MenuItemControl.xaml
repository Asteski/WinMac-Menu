<UserControl
    x:Class="WinMacMenuWinUI3.MenuItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="MenuRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" CornerRadius="4" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background"
                                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background"
                                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- SEPARATOR: thin 1px line, 9px total slot height -->
        <Grid x:Name="SeparatorRoot" Height="9" Visibility="Collapsed">
            <Rectangle Height="1"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Grid>

        <!-- CATEGORY HEADER: small semibold label, no interaction -->
        <TextBlock x:Name="CategoryRoot"
                   Margin="12,8,12,2"
                   FontSize="11"
                   FontFamily="Segoe UI Variable Small"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed"/>

        <!-- NORMAL ITEM: 34px tall, 4px horizontal margin for hover rounding -->
        <Button x:Name="ItemRoot"
                Style="{StaticResource MenuRowButton}"
                Height="34"
                Margin="4,0"
                Click="ItemRoot_Click"
                Visibility="Collapsed">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>  <!-- icon -->
                    <ColumnDefinition Width="8"/>   <!-- gap -->
                    <ColumnDefinition Width="*"/>   <!-- label -->
                    <ColumnDefinition Width="Auto"/><!-- chevron -->
                </Grid.ColumnDefinitions>

                <Image x:Name="ItemIcon"
                       Grid.Column="0"
                       Width="16" Height="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       Visibility="Collapsed"/>

                <TextBlock x:Name="ItemLabel"
                           Grid.Column="2"
                           FontSize="12"
                           FontFamily="Segoe UI Variable Text"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <FontIcon x:Name="SubArrow"
                          Grid.Column="3"
                          Glyph="&#xE76C;"
                          FontSize="10"
                          VerticalAlignment="Center"
                          Margin="4,0,0,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Visibility="Collapsed"/>
            </Grid>
        </Button>
    </Grid>
</UserControl>
