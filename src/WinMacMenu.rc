// Controls Page
IDD_PAGE_CONTROLS DIALOGEX 0,0,295,258
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg 2"
BEGIN
	GROUPBOX      "Start Menu button", -1, 15, 8, 265, 31
	CONTROL       "Left click", IDC_CTRL_LEFT_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 20, 70,  12
	CONTROL       "Right click", IDC_CTRL_RIGHT_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 20, 74,  12
	CONTROL       "Middle click", IDC_CTRL_MIDDLE_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 193, 20, 80,  12

	GROUPBOX      "Start Menu button while holding Shift", -1, 15, 42, 265, 31
	CONTROL       "Shift + Left click", IDC_CTRL_SHIFT_LEFT_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 54, 84,  12
	CONTROL       "Shift + Right click", IDC_CTRL_SHIFT_RIGHT_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 54, 82,  12
	CONTROL       "Shift + Middle click", IDC_CTRL_SHIFT_MIDDLE_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 193, 54, 84,  12

	GROUPBOX      "Windows key", -1, 15, 76, 265, 31
	CONTROL       "Windows key", IDC_CTRL_WINDOWS_KEY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 88, 82,  12
	CONTROL       "Shift + Win", IDC_CTRL_SHIFT_WINDOWS_KEY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 88, 84,  12
	CONTROL       "Win + X", IDC_CTRL_WINDOWS_KEY_X, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 193, 88, 70,  12

	GROUPBOX      "Menu settings item", -1, 15, 110, 265, 43
	LTEXT         "Show at the bottom with:", IDC_CTRL_SETTINGS_ITEM_LABEL, 23, 124, 104, 8
	COMBOBOX      IDC_CTRL_SETTINGS_ITEM_COMBO, 133, 121, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT         "Ignored when the Settings item is already present in Menu section.", -1, 23, 138, 248, 8

	GROUPBOX      "Behaviour", -1, 15, 156, 273, 76
	CONTROL       "Ignore triggers when fullscreen app is focused", IDC_IGNORE_FULLSCREEN_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 168, 257,  12

	LTEXT         "Exclusion list (comma-separated app names):", -1, 23, 184, 257, 8
	EDITTEXT      IDC_FULLSCREEN_EXCLUSION_EDIT, 23, 194, 257, 12, ES_AUTOHSCROLL | ES_MULTILINE | WS_TABSTOP

	CONTROL       "Enable legacy Taskbar support (Windows 10 or 3rd-party taskbar apps)", IDC_CTRL_LEGACY_START_DETECTION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 213, 260, 12
	LTEXT         "Reload is required for changes to take effect.", -1, 15, 244, 265, 8
END

// Advanced Page
IDD_PAGE_ADVANCED DIALOGEX 0,0,295,258
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg 2"
BEGIN
	GROUPBOX      "Recent Items", -1, 15, 8, 265, 62
	LTEXT          "Show items as", -1, 23, 22, 58, 8
	COMBOBOX       1702, 89, 20, 50, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT          "Number of items", -1, 160, 22, 72, 8
	EDITTEXT       IDC_RECENTMAX_EDIT, 231, 20, 38, 12, ES_NUMBER | WS_TABSTOP
	CONTROL        "", IDC_RECENTMAX_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 269, 20, 12, 12

    CONTROL        "Show ""Clean Recent Items list""", IDC_RECENT_SHOW_CLEAN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 36, 132, 12
	CONTROL        "List files and folders separately", IDC_RECENT_SEPARATE_ITEMS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 160, 36, 116,  12
	CONTROL        "Hide protocol links", IDC_RECENT_HIDE_PROTOCOL_SHORTCUTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 50, 120,  12

	GROUPBOX      "Task Kill", -1, 15, 74, 265, 75
	CONTROL       "Show tasks from all desktops", IDC_TASKKILL_ALL_DESKTOPS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 88, 120,  12
	CONTROL       "Show process IDs", IDC_TASKKILL_SHOW_PROCESS_IDS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 160, 88, 120,  12
	CONTROL       "List tasks as separate windows", 2002, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 102, 120,  12
	CONTROL       "Ignore system processes", 2001, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 160, 102, 120,  12
	LTEXT         "Excluded processes:", -1, 23, 119, 80, 8
	EDITTEXT      2005, 23, 130, 242, 12, ES_AUTOHSCROLL | WS_TABSTOP

	GROUPBOX      "This PC", -1, 15, 155, 100, 41
	CONTROL       "Show as a submenu", IDC_THISPC_AS_SUBMENU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 165, 88,  12
	CONTROL       "Expand as submenus", IDC_THISPC_ITEMS_AS_SUBMENUS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 177, 88,  12

    GROUPBOX      "Home", -1, 120, 155, 100, 41
    CONTROL       "Show as a submenu", IDC_HOME_AS_SUBMENU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 128, 165, 88, 12
    CONTROL       "Expand as submenus", IDC_HOME_ITEMS_AS_SUBMENUS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 128, 177, 88, 12

    GROUPBOX      "Power Menu", -1, 15, 203, 205, 54
    CONTROL       "Hibernate", IDC_POWER_HIBERNATE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 213, 65, 12
    CONTROL       "Sign out", IDC_POWER_LOGOFF, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 97, 213, 65, 12
    CONTROL       "Lock", IDC_POWER_LOCK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 173, 213, 42, 12
    CONTROL       "Shut down", IDC_POWER_SHUTDOWN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 225, 65, 12
    CONTROL       "Restart", IDC_POWER_RESTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 97, 225, 65, 12
    CONTROL       "Sleep", IDC_POWER_SLEEP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 173, 225, 42, 12
    CONTROL       "Ask for confirmation", IDC_POWER_CONFIRM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 239, 145, 12
END

// Item Edit Dialog
IDD_ITEM_EDIT DIALOGEX 0,0,220,132
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "Edit Item"
FONT 8, "MS Shell Dlg 2"
BEGIN
	LTEXT           "Type:", -1, 6, 8, 40, 8
	COMBOBOX        IDC_ITEM_TYPE_COMBO, 50, 6, 160, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT           "Label:", IDC_ITEM_LABEL_LABEL, 6, 26, 40, 8
	EDITTEXT        IDC_ITEM_LABEL, 50, 24, 160, 12, ES_AUTOHSCROLL | WS_TABSTOP
	LTEXT           "Path / URI:", IDC_ITEM_PATH_LABEL, 6, 44, 48, 8
	EDITTEXT        IDC_ITEM_PATH, 50, 42, 160, 12, ES_AUTOHSCROLL | WS_TABSTOP
	LTEXT           "Parameters:", IDC_ITEM_PARAMS_LABEL, 6, 62, 40, 8
	EDITTEXT        IDC_ITEM_PARAMS, 50, 60, 160, 12, ES_AUTOHSCROLL | WS_TABSTOP
	COMBOBOX        IDC_ITEM_FOLDER_PARAMS, 50, 60, 160, 64, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	PUSHBUTTON      "Browse", IDC_ITEM_BROWSE, 148, 78, 62, 14
	DEFPUSHBUTTON   "OK", IDOK, 70, 100, 40, 14
	PUSHBUTTON      "Cancel", IDCANCEL, 120, 100, 40, 14
END

// About Dialog
IDD_ABOUT DIALOGEX 0,0,170,110
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU
CAPTION "About WinMac Menu"
FONT 8, "MS Shell Dlg 2"
BEGIN
	LTEXT         "", IDC_ABOUT_TEXT, 12, 12, 118, 46
