#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "WinMacMenu.exe.manifest"

// Application icon
IDI_APPICON ICON "res/app.ico"
// Themed tray icon variants
IDI_TRAY_DEFAULT ICON "res/tray_default.ico"
IDI_TRAY_LIGHT ICON "res/tray_light.ico"
IDI_TRAY_DARK ICON "res/tray_dark.ico"
// About dialog specific icon
IDI_ABOUT_ICON ICON "res/about.ico"

// Version information block

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName",      "Asteski"
			VALUE "FileDescription", "WinMac Menu"
			VALUE "FileVersion",     "1.0.0"
			VALUE "InternalName",    "WinMacMenu.exe"
			VALUE "OriginalFilename", "WinMacMenu.exe"
			VALUE "ProductName",     "WinMac Menu"
			VALUE "ProductVersion",  "1.0.0"
			VALUE "LegalCopyright",  "Copyright 2026 Asteski"
		END // BLOCK "040904B0"
	END // BLOCK "StringFileInfo"
	BLOCK "VarFileInfo"
		BEGIN
			VALUE "Translation", 0x0409, 1200
		END // BLOCK "VarFileInfo"
END // VS_VERSION_INFO


// AltSnap-compatible native Win32 settings resources. Common Controls v6
// supplies the platform-specific control rendering through the manifest.
IDD_SETTINGS DIALOGEX 0, 0, 335, 310
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "WinMac Menu Settings"
FONT 8, "MS Shell Dlg 2", 0, 0, 0x0
BEGIN
	CONTROL         "", IDC_SETTINGS_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS | WS_CLIPCHILDREN, 3, 6, 324, 258
	PUSHBUTTON      "Check for updates", IDC_CHECK_UPDATES, 5, 275, 92, 16
	DEFPUSHBUTTON   "Apply", IDC_APPLY, 160, 275, 44, 16
	PUSHBUTTON      "Save && Close", IDC_SAVEEXIT, 208, 275, 76, 16
	PUSHBUTTON      "Exit", IDC_EXIT, 288, 275, 44, 16
	PUSHBUTTON      "Cancel", IDC_CANCEL, 336, 275, 44, 16
END

// General Page
IDD_PAGE_GENERAL DIALOGEX 0,0,295,258
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg 2"
BEGIN
	GROUPBOX      "Appearance", -1, 15, 10, 265, 46
	LTEXT         "Theme", IDC_RENDERER_LABEL, 23, 24, 60, 8
	COMBOBOX      IDC_RENDERER_COMBO, 144, 22, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	CONTROL       "Touch mode", IDC_WINUI_SIZE_COMBO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 39, 120, 10
	CONTROL       "Show thumbnails", IDC_WINUI_ALWAYS_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 39, 120, 10

	GROUPBOX      "Behaviour", -1, 15, 62, 265, 61
	LTEXT         "Show icons", -1, 23, 76, 45, 8
	COMBOBOX      IDC_SHOWICONS, 74, 74, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT         "Submenu depth", -1, 144, 76, 64, 8
	EDITTEXT      IDC_FOLDERDEPTH_EDIT, 214, 74, 38, 12, ES_NUMBER | WS_TABSTOP
	CONTROL       "", IDC_FOLDERDEPTH_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 252, 74, 12, 12
	CONTROL       "Show hidden files", IDC_SHOWHIDDEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 94, 120, 10
	CONTROL       "Show dotfiles", IDC_SHOWDOTFILES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 94, 120, 10
	CONTROL       "Show file extensions", IDC_SHOWEXTENSIONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 106, 120, 10
	CONTROL       "Hide icons in root menu", IDC_HIDEICONSINROOT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 106, 120, 10

	GROUPBOX      "Sorting", -1, 15, 129, 265, 63
	LTEXT         "Sort by", -1, 23, 143, 70, 8
	COMBOBOX      IDC_SORT_FIELD, 144, 141, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT         "Direction", -1, 23, 159, 70, 8
	COMBOBOX      IDC_SORT_DIRECTION, 144, 157, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT         "Override sort order", -1, 23, 175, 90, 8
	COMBOBOX      IDC_SORT_FOLDERSFIRST, 144, 173, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

	GROUPBOX      "Startup", -1, 15, 198, 265, 45
	CONTROL       "Run at startup", IDC_STARTONLOGIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 212, 120, 10
	CONTROL       "Show Menu on start", IDC_SHOWONLAUNCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 212, 120, 10
	CONTROL       "Show tray icon", IDC_SHOWTRAYICON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 226, 120, 10
	CONTROL       "Monochrome tray icon", IDC_MONOTRAYICON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 226, 120, 10

END

// Placement Page
IDD_PAGE_PLACEMENT DIALOGEX 0,0,295,220
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg 2"
BEGIN
	GROUPBOX        "Positioning", -1, 15, 6, 265, 51
	LTEXT           "Horizontal", -1, 25, 24, 60, 8
	COMBOBOX        IDC_HPLACEMENT_COMBO, 91, 22, 50, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT           "Horizontal offset", -1, 159, 24, 80, 8
	EDITTEXT        IDC_HOFFSET_EDIT, 240, 22, 38, 12, ES_NUMBER | WS_TABSTOP
	CONTROL         "", IDC_HOFFSET_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 278, 22, 12, 12
	LTEXT           "Vertical", -1, 25, 40, 60, 8
	COMBOBOX        IDC_VPLACEMENT_COMBO, 91, 38, 50, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT           "Vertical offset", -1, 159, 40, 80, 8
	EDITTEXT        IDC_VOFFSET_EDIT, 240, 38, 38, 12, ES_NUMBER | WS_TABSTOP
	CONTROL         "", IDC_VOFFSET_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 278, 38, 12, 12

	GROUPBOX        "Behaviour", -1, 15, 65, 265, 70
	CONTROL         "Position menu relative to mouse pointer", IDC_POINTERRELATIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 25, 79, 180, 12
	LTEXT           "Ignore offset when centered", -1, 25, 102, 190, 8
	COMBOBOX        IDC_IGNORE_CENTERED_COMBO, 222, 100, 56, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT           "Ignore offset when positioning is relative", IDC_IGNORE_RELATIVE_LABEL, 25, 118, 190, 8
	COMBOBOX        IDC_IGNORE_RELATIVE_COMBO, 222, 116, 56, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_DISABLED
END

// Menu Page
IDD_PAGE_MENU DIALOGEX 0,0,295,190
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg 2"
BEGIN
	// Runtime relayout in settings.c controls exact list/button sizes for Menu/Icons pages.
	CONTROL         "", IDC_MENU_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL, 6, 10, 220, 146
	PUSHBUTTON      "Add", IDC_MENU_ADD, 232, 10, 82, 20
	PUSHBUTTON      "Edit", IDC_MENU_EDIT, 232, 34, 82, 20
	PUSHBUTTON      "Delete", IDC_MENU_DELETE, 232, 58, 82, 20
	PUSHBUTTON      "Up", IDC_MENU_UP, 232, 92, 82, 20
	PUSHBUTTON      "Down", IDC_MENU_DOWN, 232, 116, 82, 20
END

// Icons Page
IDD_PAGE_ICONS DIALOGEX 0,0,295,190
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg 2"
BEGIN
	CONTROL         "", IDC_ICONS_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL, 6, 10, 220, 146
	PUSHBUTTON      "Browse", IDC_ICON_BROWSE_FILE, 232, 10, 82, 20
	PUSHBUTTON      "Browse light", IDC_ICON_BROWSE_LIGHT, 232, 34, 82, 20
	PUSHBUTTON      "Browse dark", IDC_ICON_BROWSE_DARK, 232, 58, 82, 20
	PUSHBUTTON      "Clear", IDC_ICON_CLEAR, 232, 82, 82, 20
END

