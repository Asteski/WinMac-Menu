#include <windows.h>
#include "resource.h"

// Application icon
IDI_APPICON ICON "res/app.ico"
// Themed tray icon variants
IDI_TRAY_LIGHT ICON "res/tray_light.ico"
IDI_TRAY_DARK ICON "res/tray_dark.ico"
// About dialog specific icon
IDI_ABOUT_ICON ICON "res/about.ico"

// Version information block

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,14,0
 PRODUCTVERSION 0,14,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName",      "Asteski"
			VALUE "FileDescription", "WinMac Menu"
			VALUE "FileVersion",     "0.14.0"
			VALUE "InternalName",    "WinMacMenu.exe"
			VALUE "OriginalFilename", "WinMacMenu.exe"
			VALUE "ProductName",     "WinMac Menu"
			VALUE "ProductVersion",  "0.14.0"
			VALUE "LegalCopyright",  "Copyright 2026 Asteski"
		END // BLOCK "040904B0"
	END // BLOCK "StringFileInfo"
	BLOCK "VarFileInfo"
		BEGIN
			VALUE "Translation", 0x0409, 1200
		END // BLOCK "VarFileInfo"
END // VS_VERSION_INFO


// Settings dialog (basic subset of INI options)
IDD_SETTINGS DIALOGEX 0, 0, 315, 292
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "WinMac Menu Settings"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
	CONTROL         "", IDC_SETTINGS_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS | WS_CLIPCHILDREN, 6, 6, 303, 240
	DEFPUSHBUTTON   "Apply", IDC_APPLY, 120, 257, 60, 16
	PUSHBUTTON      "Save && Close", IDC_SAVEEXIT, 184, 257, 80, 16
	PUSHBUTTON      "Exit", IDC_EXIT, 220, 257, 44, 16
	PUSHBUTTON      "Cancel", IDC_CANCEL, 268, 257, 44, 16
END

// General Page
IDD_PAGE_GENERAL DIALOGEX 0,0,295,220
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 9, "Segoe UI"
BEGIN
	GROUPBOX      "Menus behaviour", -1, 8, 6, 278, 74
	CONTROL       "Show hidden files", IDC_SHOWHIDDEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 20, 120, 10
	CONTROL       "Show dotfiles", IDC_SHOWDOTFILES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 32, 120, 10
	CONTROL       "Show file extensions", IDC_SHOWEXTENSIONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 44, 120, 10
	CONTROL       "", IDC_KEEPCTXOPEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 56, 10, 10
	LTEXT         "Keep menu open after triggering", -1, 28, 56, 125, 8
	LTEXT         "context menu action", -1, 28, 66, 100, 8
	LTEXT         "Show menu icons", -1, 150, 20, 120, 8
	COMBOBOX      IDC_SHOWICONS, 150, 30, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	CONTROL       "Show folder icons", IDC_SHOWFOLDERICONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 150, 46, 120, 10
	CONTROL       "Show file icons", IDC_SHOWFILEICONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 150, 58, 120, 10

	GROUPBOX      "Program behaviour", -1, 8, 86, 278, 40
	CONTROL       "Start on login", IDC_STARTONLOGIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 98, 120, 10
	CONTROL       "Show on launch", IDC_SHOWONLAUNCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 150, 98, 120, 10
	CONTROL       "Monochrome tray icon", IDC_MONOTRAYICON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 110, 120, 10
	CONTROL       "Show tray icon", IDC_SHOWTRAYICON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 150, 110, 120, 10
	GROUPBOX      "Included power options", -1, 8, 130, 278, 40
	CONTROL       "Hibernate", IDC_POWER_HIBERNATE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 144, 70, 10
	CONTROL       "Lock", IDC_POWER_LOCK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 144, 50, 10
	CONTROL       "Restart", IDC_POWER_RESTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 200, 144, 60, 10
	CONTROL       "Sign out", IDC_POWER_LOGOFF, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 156, 70, 10
	CONTROL       "Shutdown", IDC_POWER_SHUTDOWN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 156, 70, 10
	CONTROL       "Sleep", IDC_POWER_SLEEP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 200, 156, 50, 10
	LTEXT         "Changes to the ""Show tray icon"" and ""Monochrome tray icon"" settings require a reload to take effect. The reload option is available from the WinMac Menu tray icon context menu.", -1, 8, 176, 278, 24
END

