// Controls Page
IDD_PAGE_CONTROLS DIALOGEX 0,0,295,160
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 9, "Segoe UI"
BEGIN
	LTEXT         "Enable activation of WinMac Menu using the triggers listed below:", -1, 8, 8, 279, 8

	GROUPBOX      "Start Menu button", -1, 6, 24, 283, 26
	CONTROL       "Left click", IDC_CTRL_LEFT_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 36, 70, 10
	CONTROL       "Right click", IDC_CTRL_RIGHT_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 104, 36, 74, 10
	CONTROL       "Middle click", IDC_CTRL_MIDDLE_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 36, 80, 10

	GROUPBOX      "Start Menu button while holding Shift", -1, 6, 56, 283, 26
	CONTROL       "Shift + Left click", IDC_CTRL_SHIFT_LEFT_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 68, 86, 10
	CONTROL       "Shift + Right click", IDC_CTRL_SHIFT_RIGHT_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 104, 68, 90, 10
	CONTROL       "Shift + Middle click", IDC_CTRL_SHIFT_MIDDLE_CLICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 68, 84, 10

	GROUPBOX      "Windows Key", -1, 6, 88, 283, 26
	CONTROL       "Windows Key", IDC_CTRL_WINDOWS_KEY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 100, 80, 10
	CONTROL       "Shift + Windows Key", IDC_CTRL_SHIFT_WINDOWS_KEY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 104, 100, 120, 10

	GROUPBOX      "Fullscreen applications", -1, 6, 120, 283, 56
	CONTROL       "Ignore triggers when fullscreen app is focused", IDC_IGNORE_FULLSCREEN_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 132, 260, 10

	LTEXT         "Exclusion list (comma-separated app names):", -1, 14, 148, 260, 8
	EDITTEXT      IDC_FULLSCREEN_EXCLUSION_EDIT, 14, 158, 260, 12, ES_AUTOHSCROLL | ES_MULTILINE | WS_TABSTOP

	LTEXT         "A reload is required for the changes to take effect. The reload option is available from the WinMac Menu tray icon context menu.", -1, 8, 178, 279, 36
END

// Advanced Page
IDD_PAGE_ADVANCED DIALOGEX 0,0,295,240
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 9, "Segoe UI"
BEGIN
	GROUPBOX      "Recent Items", -1, 6, 8, 283, 48
	// Row 1
	CONTROL        "Show file extensions", IDC_RECENT_SHOW_EXT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 22, 120, 10
	LTEXT          "Show items as", -1, 120, 22, 60, 8
	COMBOBOX       1702, 235, 20, 44, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	// Row 2
	CONTROL        "Show 'Clean Recent Items'", IDC_RECENT_SHOW_CLEAN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 36, 140, 10
	LTEXT          "Number of jumplist items", -1, 120, 36, 110, 8
	EDITTEXT       IDC_RECENTMAX_EDIT, 235, 34, 34, 12, ES_NUMBER | WS_TABSTOP
	CONTROL        "", IDC_RECENTMAX_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 269, 34, 12, 12
	GROUPBOX      "Task Kill", -1, 6, 60, 283, 74
	// First row of checkboxes
	CONTROL       "Show tasks from all desktops", 2000, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 74, 120, 10
	CONTROL       "Ignore system processes", 2001, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 150, 74, 120, 10
	// Second row of checkboxes
	CONTROL       "List tasks as separate windows", 2002, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 88, 140, 10
	CONTROL       "Show icons", 2004, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 150, 88, 120, 10
	// Exclude processes textbox below checkboxes
	LTEXT         "Exclude processes", -1, 14, 102, 80, 8
	EDITTEXT      2005, 100, 100, 170, 12, ES_AUTOHSCROLL | WS_TABSTOP
	// Number of tasks to display below exclude processes, like jumplist style
	LTEXT         "Number of tasks", -1, 14, 119, 110, 8
	EDITTEXT      2003, 100, 117, 34, 12, ES_NUMBER | WS_TABSTOP
	CONTROL       "", 2103, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 134, 117, 12, 12
	// This PC section (bottom, moved up)
	GROUPBOX      "This PC", -1, 6, 140, 283, 24
	CONTROL       "Show as a submenu", IDC_THISPC_AS_SUBMENU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 150, 90, 10
	CONTROL       "Expand menu items as submenus", IDC_THISPC_ITEMS_AS_SUBMENUS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 150, 120, 10
	CONTROL       "Show icons", IDC_THISPC_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 235, 150, 50, 10

	// Home section (same size as This PC)
	GROUPBOX      "Home", -1, 6, 168, 283, 24
	CONTROL       "Show as a submenu", IDC_HOME_AS_SUBMENU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 178, 90, 10
	CONTROL       "Expand menu items as submenus", IDC_HOME_ITEMS_AS_SUBMENUS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 178, 120, 10
	CONTROL       "Show icons", IDC_HOME_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 235, 178, 50, 10
END

