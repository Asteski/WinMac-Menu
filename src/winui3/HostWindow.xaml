<Window
    x:Class="WinMacMenuWinUI3.HostWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Invisible keepalive window. WinUI3 exits when all windows are closed,
        so this hidden, zero-opacity 1×1 window keeps the process alive while RunInBackground=true.
        It also owns the HWND that Shell_NotifyIcon uses for tray callbacks.
    -->
    <Grid Background="Transparent"/>
</Window>
